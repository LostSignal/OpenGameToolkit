    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "PointLight",
    "m_FunctionSource": "",
    "m_FunctionBody": "float2 delta = ScreenPosition - LightPosition;\ndelta.x *= Width / max(Height, 1.0);\n\n// Radius is measured in screen heights, so the light stays round on any aspect ratio\nfloat attenuation = pow(saturate(1.0 - length(delta) / max(Radius, 0.0001)), max(Falloff, 0.0001));\nfloat3 light = AmbientColor.rgb + LightColor.rgb * attenuation;\n\nfloat4 baseColor = Albedo * Tint;\nColor = baseColor.rgb * light;\nAlpha = baseColor.a;"
}
